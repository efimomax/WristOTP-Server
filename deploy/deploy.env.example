# Copy to deploy/deploy.env (git-ignored) and adjust.
# Скопируйте в deploy/deploy.env (не попадает в git) и поправьте.

# SSH destination: a host alias from ~/.ssh/config or user@host.
# The user needs passwordless sudo on the server.
# Куда подключаться по SSH: алиас из ~/.ssh/config или user@host.
# Пользователю нужен sudo без пароля на сервере.
DEPLOY_HOST=user@relay.example.com

# Public HTTPS address of your relay (checked after deployment).
# Публичный HTTPS-адрес вашего релея (проверяется после деплоя).
PUBLIC_URL=https://relay.example.com
